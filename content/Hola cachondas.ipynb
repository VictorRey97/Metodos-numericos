   "source": [
    "# factorial.py\n",
    "n = int(input(\"Número entero ≥ 0: \"))\n",
    "if n < 0:\n",
    "    print(\"El factorial no está definido para números negativos.\")\n",
    "else:\n",
    "    fact = 1\n",
    "    for i in range(1, n + 1):\n",
    "        fact *= i\n",
    "    print(f\"{n}! = {fact}\")"
   ]
  },
